#@host= https://archive-api.open-meteo.com
@host= http://localhost:8081
@props=temperature_2m,relative_humidity_2m,precipitation,wind_speed_10m,wind_direction_10m,weather_code

GET {{host}}/v1/archive
?latitude={{$dotenv LAT}}
&longitude={{$dotenv LONG}}
&start_date=2026-08-08
&end_date=2026-08-11
&hourly={{props}}
&wind_speed_unit=ms
