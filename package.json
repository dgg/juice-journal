{
	"name": "juice-journal",
	"module": "index.ts",
	"type": "module",
	"private": true,
	"devDependencies": {
		"@types/bun": "1.4.0",
		"@types/luxon": "3.7.5",
		"dbmate": "2.35.1",
		"pino-pretty": "13.1.3",
		"prettier": "3.9.6"
	},
	"peerDependencies": {
		"typescript": "7.0.2"
	},
	"scripts": {
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"db:status": "bunx --bun --no-install dbmate status",
		"db:up": "bunx --bun --no-install dbmate up",
		"db:down": "bunx --bun --no-install dbmate down",
		"db:new": "bunx --bun --no-install dbmate new",
		"serve": "bun src/backend/index.ts",
		"dev": "bun --watch src/backend/index.ts",
		"check": "bun x --bun --no-install tsc --noEmit"
	},
	"dependencies": {
		"@hono/structured-logger": "1.0.0",
		"@hono/zod-validator": "0.9.0",
		"hono": "4.13.5",
		"hono-problem-details": "0.11.0",
		"luxon": "3.7.2",
		"pino": "10.3.1",
		"zod": "4.5.4"
	}
}
