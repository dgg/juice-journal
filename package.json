{
	"name": "juice-journal",
	"module": "index.ts",
	"type": "module",
	"private": true,
	"devDependencies": {
		"@types/bun": "latest",
		"dbmate": "^2.34.1",
		"prettier": "^3.9.5"
	},
	"peerDependencies": {
		"typescript": "^5"
	},
	"scripts": {
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"db:status": "bunx --bun --no-install dbmate status",
		"db:up": "bunx --bun --no-install dbmate up",
		"db:down": "bunx --bun --no-install dbmate down",
		"db:new": "bunx --bun --no-install dbmate new"
	},
	"dependencies": {
		"hono": "^4.12.29",
		"postgres": "^3.4.9"
	}
}
